<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>User Register</title>
</head>
<body>
    <form action="user/register" method="post">
            Name:<input type="text" name="name"/><br/>
            Email ID: <input type="text" name="email"/><br/>
